{
  "$schema": "https://opencode.ai/config.json",
  "model": "claude-agent/opus",
  // BEGIN MCP servers (generated by `make agent-mcp`)
  "mcp": {
    "servers": {
      "browse": {
        "type": "local",
        "command": [
          "/Users/johnharlow/.local/bin/browse",
          "mcp"
        ]
      },
      "linear": {
        "type": "remote",
        "url": "https://mcp.linear.app/mcp"
      }
    }
  },
  // END MCP servers
  // Server plugins in the global config directory aren't discovered
  // automatically (only a project's .opencode/plugins are), so list them here.
  // The CLI loads their TUI parts from this list too.
  "plugins": ["./plugins/sessions"],
  "formatter": true,
  "lsp": true,
  "permissions": [],
  "username": "John",
}
