{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "buildkite": {
      "type": "remote",
      "url": "https://mcp.buildkite.com/mcp",
    },
    "datadog": {
      "type": "remote",
      "url": " https://mcp.datadoghq.com/api/unstable/mcp-server/mcp",
    },
    "sightglass": {
      "type": "remote",
      "url": "http://localhost:4444/api/mcp",
    },
  },
  "formatter": true,
  "lsp": true,
  "permission": {
    "websearch": "allow",
    "external_directory": {
      // /tmp is a symlink to /private/tmp on macOS, so allow both forms
      "/tmp/**": "allow",
      "/private/tmp/**": "allow",
    },
  },
  "username": "John",
}
