{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "buildkite": {
      "type": "remote",
      "url": "https://mcp.buildkite.com/mcp"
    },
    "datadog": {
      "type": "remote",
      "url": "https://mcp.datadoghq.com/v1/mcp"
    },
    "sightglass": {
      "type": "remote",
      "url": "http://localhost:4444/api/mcp"
    },
    "slack": {
      "type": "remote",
      "url": "https://mcp.slack.com/mcp"
    },
  },
  "agent": {
    "plan": { "model": "openai/gpt-5.6-terra", "variant": "max" },
    "explore": { "model": "openai/gpt-5.6-luna", "variant": "max" },
  },
  "formatter": true,
  "lsp": true,
  "permission": {
    "websearch": "allow",
    "external_directory": {
      // /tmp is a symlink to /private/tmp on macOS, so allow both forms
      "/tmp/**": "allow",
      "/private/tmp/**": "allow",
    },
  },
  "username": "John",
}
