{
  "theme": { "name": "gruvbox", "mode": "system" },
  "attention": {
    "enabled": true,
    "sound": true
  },
  "animations": true,
  "tabs": {
    "layout": "horizontal",
    "mode": "auto"
  },
  "keybinds": {
    "session.tab.previous": "ctrl+shift+tab,alt+up",
    "session.tab.next": "ctrl+tab,alt+down",
    "session.new": "<leader>ctrl+n",
    "session.tab.close": "<leader>ctrl+w"
  }
}
